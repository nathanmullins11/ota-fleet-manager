# Copy to .env (which git ignores) and set a real password:  cp .env.example .env

# Required
POSTGRES_PASSWORD=change-me

# Optional (defaults shown)
# POSTGRES_USER=ota
# POSTGRES_DB=ota
# HEARTBEAT_TIMEOUT_SECONDS=30
# OFFLINE_CHECK_INTERVAL_SECONDS=5
# COMMAND_TIMEOUT_SECONDS=120
# LOG_LEVEL=INFO

# Software registry address as the devices see it (it goes into update and rollback
# commands). The default suits devices on the same machine as the control plane.
# On the cloud VM, use its Elastic IP:
# REGISTRY_PUBLIC_URL=http://203.0.113.10:8080
