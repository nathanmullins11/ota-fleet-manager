# Copy to .env (which git ignores) and set a real password:  cp .env.example .env

# Required
POSTGRES_PASSWORD=change-me

# Optional (defaults shown)
# POSTGRES_USER=ota
# POSTGRES_DB=ota
# HEARTBEAT_TIMEOUT_SECONDS=30
# OFFLINE_CHECK_INTERVAL_SECONDS=5
# COMMAND_TIMEOUT_SECONDS=120
# Default health limits for rollouts (automatic rollback); cli.py can override per rollout:
# HEALTH_WINDOW_SECONDS=60          watch each device this long after it updates
# HEALTH_MAX_CRASHES=0              firmware crashes allowed per device in the window
# HEALTH_MAX_ERRORS=10              firmware errors allowed per device in the window
# HEALTH_MAX_FAILED_DEVICES=0       failed installs allowed before the rollout halts
# HEALTH_UNRESPONSIVE_SECONDS=45    silence after updating that counts as unresponsive
# LOG_LEVEL=INFO

# Software registry address as the devices see it (it goes into update and rollback
# commands). The default suits devices on the same machine as the control plane.
# On the cloud VM, use its Elastic IP:
# REGISTRY_PUBLIC_URL=http://203.0.113.10:8080
