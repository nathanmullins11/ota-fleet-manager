# Broker running in the control-plane Compose stack on this same machine:
MQTT_HOST=host.docker.internal
#   Broker on the cloud VM (use its Elastic IP):
# MQTT_HOST=203.0.113.10
MQTT_PORT=8883

# The control plane's CA certificate (tools/mqtt_security.py setup writes it). Copy it here
# from the VM when the broker runs in the cloud.
# MQTT_CA_FILE=../mqtt/generated/ca.crt

# fleet.sh derives each device's password from DEVICE_SECRET (or reads it from
# ../mqtt/generated/device.env). docker-compose.yml needs the derived password itself:
#   python tools/mqtt_security.py device-password device-001
# DEVICE_SECRET=
DEVICE_001_PASSWORD=

# Optional (defaults shown)
# REGISTRY_URL=http://<MQTT_HOST>:8080   (devices refuse downloads from anywhere else)
# HEARTBEAT_INTERVAL_SECONDS=5
# LOG_LEVEL=INFO
